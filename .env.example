# Neon (recommended): Dashboard → Connect → copy both URLs
# Use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Local PostgreSQL (alternative)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/propertyconnect"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/propertyconnect"

