# Neon (recommended): Dashboard → Connect → copy both URLs
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-value"
ADMIN_EMAIL="admin@propertyconnect.local"
ADMIN_PASSWORD="ChangeMe123!"
NEXT_PUBLIC_APP_NAME="PropertyConnect AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- WhatsApp Provider ---
WHATSAPP_PROVIDER=evolution
WHATSAPP_ENABLED=false

# Evolution API (recommended for local/dev QR pairing)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace-with-secure-api-key
EVOLUTION_API_INSTANCE_NAME=propertyconnect
EVOLUTION_API_INTEGRATION=WHATSAPP-BAILEYS
EVOLUTION_WEBHOOK_SECRET=replace-with-a-long-random-secret
EVOLUTION_WEBHOOK_URL=http://localhost:3000/api/webhooks/evolution
EVOLUTION_REJECT_CALLS=true
EVOLUTION_IGNORE_GROUPS=true
EVOLUTION_ALWAYS_ONLINE=false
EVOLUTION_READ_MESSAGES=false
EVOLUTION_READ_STATUS=false

# Public WhatsApp display number (never put API keys here)
NEXT_PUBLIC_WHATSAPP_NUMBER="+923412879311"

# Queue / batch sending (optional Redis for future BullMQ worker)
REDIS_URL=redis://localhost:6379
WHATSAPP_BATCH_SIZE=25
WHATSAPP_BATCH_DELAY_MS=3000
WHATSAPP_MAX_RETRIES=3
WHATSAPP_FAILURE_PAUSE_PERCENT=10
WHATSAPP_MEDIA_MAX_BYTES=104857600

# Legacy Green API (optional)
# WHATSAPP_PROVIDER=green-api
# GREEN_API_URL="https://7107.api.greenapi.com"
# GREEN_API_INSTANCE_ID=""
# GREEN_API_API_TOKEN=""

# Future Meta Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_FACEBOOK_APP_SECRET=""

# Meta (legacy env names still supported)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TEMPLATE_NAME="hello_world"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
STORAGE_PROVIDER=local

NEXT_PUBLIC_INSTAGRAM_URL=""
